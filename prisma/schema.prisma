generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ——— Better Auth tables ———

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]

  memberships      OrgMembership[]
  assignedTasks    Task[]           @relation("TaskAssignee")
  createdTasks     Task[]           @relation("TaskCreator")
  comments         Comment[]
  notifications    Notification[]
  uploadedFiles    Attachment[]
  ownedGoals       Goal[]           @relation("GoalOwner")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ——— Strata domain (multi-home tasks) ———

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships OrgMembership[]
  teams       Team[]
  projects    Project[]
  tasks       Task[]
  goals       Goal[]
  portfolios  Portfolio[]
  forms       ProjectForm[]
  rules       AutomationRule[]
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

model OrgMembership {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           OrgRole      @default(MEMBER)
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model Team {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projects     Project[]

  @@index([organizationId])
}

model Project {
  id             String   @id @default(cuid())
  organizationId String
  teamId         String?
  name           String
  description    String?
  color          String   @default("#2F6F5E")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team?             @relation(fields: [teamId], references: [id], onDelete: SetNull)
  sections     Section[]
  memberships  TaskMembership[]
  portfolios   PortfolioProject[]
  forms        ProjectForm[]
  rules        AutomationRule[]

  @@index([organizationId])
}

model Section {
  id        String   @id @default(cuid())
  projectId String
  name      String
  position  Float    @default(0)
  createdAt DateTime @default(now())

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  memberships TaskMembership[]

  @@index([projectId])
}

model Task {
  id             String    @id @default(cuid())
  organizationId String
  title          String
  description    String    @default("")
  completedAt    DateTime?
  /// Optional start for timeline / Gantt-style views
  startOn        DateTime? @db.Date
  dueOn          DateTime? @db.Date
  assigneeId     String?
  creatorId      String?
  parentTaskId   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignee     User?             @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator      User?             @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  parent       Task?             @relation("Subtasks", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subtasks     Task[]            @relation("Subtasks")
  /// Multi-home: one task can appear in many projects/sections
  memberships  TaskMembership[]
  comments     Comment[]
  attachments  Attachment[]

  @@index([organizationId])
  @@index([assigneeId])
  @@index([dueOn])
}

model TaskMembership {
  id        String   @id @default(cuid())
  taskId    String
  projectId String
  sectionId String
  /// Order within the section (fractional indexing via float for MVP)
  position  Float    @default(0)
  createdAt DateTime @default(now())

  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([taskId, projectId])
  @@index([sectionId, position])
  @@index([projectId])
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Attachment {
  id           String   @id @default(cuid())
  taskId       String
  uploaderId   String
  fileName     String
  mimeType     String
  sizeBytes    Int
  /// Local path or remote URL — Core stores metadata; blob under /uploads locally
  storageKey   String
  createdAt    DateTime @default(now())

  task     Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploader User @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

enum NotificationKind {
  ASSIGNED
  COMMENT
  MENTION
  DUE_SOON
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  kind      NotificationKind
  title     String
  body      String           @default("")
  href      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

// ——— Portfolio layer ———

enum GoalStatus {
  ON_TRACK
  AT_RISK
  OFF_TRACK
  COMPLETE
}

model Goal {
  id             String     @id @default(cuid())
  organizationId String
  title          String
  description    String     @default("")
  status         GoalStatus @default(ON_TRACK)
  progress       Int        @default(0)
  ownerId        String?
  targetDate     DateTime?  @db.Date
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?        @relation("GoalOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([organizationId])
}

model Portfolio {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  color          String   @default("#2F6F5E")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projects     PortfolioProject[]

  @@index([organizationId])
}

model PortfolioProject {
  id          String   @id @default(cuid())
  portfolioId String
  projectId   String
  createdAt   DateTime @default(now())

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, projectId])
  @@index([projectId])
}

// ——— Automation ———

enum FormFieldType {
  TEXT
  TEXTAREA
  EMAIL
  SELECT
}

model ProjectForm {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String
  title          String
  description    String   @default("")
  slug           String
  isOpen         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fields       FormField[]
  submissions  FormSubmission[]

  @@unique([organizationId, slug])
  @@index([projectId])
}

model FormField {
  id         String        @id @default(cuid())
  formId     String
  label      String
  fieldType  FormFieldType @default(TEXT)
  required   Boolean       @default(true)
  options    String        @default("")
  position   Float         @default(0)

  form ProjectForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
}

model FormSubmission {
  id            String   @id @default(cuid())
  formId        String
  payload       String
  createdTaskId String?
  createdAt     DateTime @default(now())

  form ProjectForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
}

enum RuleTrigger {
  TASK_COMPLETED
  TASK_CREATED
  TASK_ASSIGNED
}

enum RuleAction {
  MOVE_TO_SECTION
  ADD_COMMENT
  SET_ASSIGNEE
}

model AutomationRule {
  id             String      @id @default(cuid())
  organizationId String
  projectId      String
  name           String
  enabled        Boolean     @default(true)
  trigger        RuleTrigger
  action         RuleAction
  /// JSON: { sectionId?, commentBody?, assigneeId? }
  actionConfig   String      @default("{}")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, enabled])
  @@index([organizationId])
}
